`timescale 1ns/1ps

module tb_async_fifo;

parameter ADDR_WIDTH = 4;
parameter DATA_WIDTH = 8;
parameter DEPTH      = (1 << ADDR_WIDTH);

logic wr_clk;
logic wr_rst;
logic wr_en;

logic rd_clk;
logic rd_rst;
logic rd_en;

logic [DATA_WIDTH-1:0] data_in;

wire [DATA_WIDTH-1:0] data_out;
wire full;
wire empty;


async_top #(
    .addr_width(ADDR_WIDTH),
    .data_width(DATA_WIDTH)
) dut (
    .wr_clk   (wr_clk),
    .wr_rst   (wr_rst),
    .wr_en    (wr_en),

    .rd_clk   (rd_clk),
    .rd_rst   (rd_rst),
    .rd_en    (rd_en),

    .data_in  (data_in),
    .data_out (data_out),

    .full     (full),
    .empty    (empty)
);


initial begin
    wr_clk = 0;
    forever #5 wr_clk = ~wr_clk;     // 100 MHz
end

initial begin
    rd_clk = 0;
    forever #7 rd_clk = ~rd_clk;     // ~71.4 MHz
end



logic [DATA_WIDTH-1:0] expected_queue[$];

integer write_count;
integer read_count;
integer error_count;

logic [DATA_WIDTH-1:0] expected_data;


always @(posedge wr_clk) begin

    if (wr_rst) begin

        if (wr_en && !full) begin

            expected_queue.push_back(data_in);

            write_count++;

            $display(
                "[WRITE] t=%0t data=%h queue_size=%0d",
                $time,
                data_in,
                expected_queue.size()
            );

        end

    end

end


always @(posedge rd_clk) begin

    if (rd_rst) begin

        if (rd_en && !empty) begin

            if (expected_queue.size() == 0) begin

                $display(
                    "[ERROR] t=%0t DUT read occurred but scoreboard is empty",
                    $time
                );

                error_count++;

            end
            else begin

                expected_data = expected_queue.pop_front();

                if (data_out !== expected_data) begin

                    $display(
                        "[FAIL] t=%0t expected=%h actual=%h",
                        $time,
                        expected_data,
                        data_out
                    );

                    error_count++;

                end
                else begin

                    $display(
                        "[PASS] t=%0t expected=%h actual=%h",
                        $time,
                        expected_data,
                        data_out
                    );

                end

                read_count++;

            end

        end

    end

end



task automatic fifo_write(
    input logic [DATA_WIDTH-1:0] value
);

begin

    // Wait until FIFO can accept a write
    while (full)
        @(negedge wr_clk);

    @(negedge wr_clk);

    wr_en   = 1'b1;
    data_in = value;

    // DUT accepts write on following posedge
    @(negedge wr_clk);

    wr_en = 1'b0;

end

endtask


task automatic fifo_read;

begin

    // Wait until FIFO contains data
    while (empty)
        @(negedge rd_clk);

    @(negedge rd_clk);

    rd_en = 1'b1;

    // DUT performs read at following posedge
    @(negedge rd_clk);

    rd_en = 1'b0;

end

endtask




task automatic reset_fifo;

begin

    wr_rst  = 0;
    rd_rst  = 0;

    wr_en   = 0;
    rd_en   = 0;
    data_in = 0;

    repeat(3) @(posedge wr_clk);

    wr_rst = 1;
    rd_rst = 1;

    repeat(3) @(posedge wr_clk);

end

endtask



initial begin

    write_count = 0;
    read_count  = 0;
    error_count = 0;

    wr_en   = 0;
    rd_en   = 0;
    data_in = 0;

  

    reset_fifo();

    $display("\n--------------------------------");
    $display("TEST 1 : RESET");
    $display("--------------------------------");

    if (empty !== 1'b1) begin
        $display("[FAIL] FIFO should be empty after reset");
        error_count++;
    end
    else
        $display("[PASS] FIFO empty after reset");

    if (full !== 1'b0) begin
        $display("[FAIL] FIFO should not be full after reset");
        error_count++;
    end
    else
        $display("[PASS] FIFO not full after reset");



    $display("\n--------------------------------");
    $display("TEST 2 : BASIC WRITE / READ");
    $display("--------------------------------");

    fifo_write(8'h11);
    fifo_write(8'h22);
    fifo_write(8'h33);
    fifo_write(8'h44);

    fifo_read();
    fifo_read();
    fifo_read();
    fifo_read();



    $display("\n--------------------------------");
    $display("TEST 3 : POINTER WRAPAROUND");
    $display("--------------------------------");

    // More than FIFO depth total transactions
    for (int i = 0; i < 40; i++) begin

        fifo_write(i);

        if ((i % 2) == 1)
            fifo_read();

    end

    // Drain remaining data
    while (!empty)
        fifo_read();




    $display("\n--------------------------------");
    $display("TEST 4 : RANDOM TRAFFIC");
    $display("--------------------------------");

    fork

        begin : random_writer

            repeat(100) begin

                @(negedge wr_clk);

                if (!full && $urandom_range(0,1)) begin
                    wr_en   = 1;
                    data_in = $urandom_range(0,255);
                end
                else begin
                    wr_en = 0;
                end

            end

            @(negedge wr_clk);
            wr_en = 0;

        end


        begin : random_reader

            repeat(100) begin

                @(negedge rd_clk);

                if (!empty && $urandom_range(0,1))
                    rd_en = 1;
                else
                    rd_en = 0;

            end

            @(negedge rd_clk);
            rd_en = 0;

        end

    join


    // Drain whatever remains
    while (!empty)
        fifo_read();


    // Give scoreboard time to finish
    #50;



    $display("Successful writes : %0d", write_count);
    $display("Successful reads  : %0d", read_count);
    $display("Remaining expected: %0d", expected_queue.size());
    $display("Errors            : %0d", error_count);

    if ((error_count == 0) &&
        (expected_queue.size() == 0)) begin

        $display("\n*** ALL FIFO TESTS PASSED ***");

    end
    else begin

        $display("\n*** FIFO TEST FAILED ***");

    end



    $finish;

end

endmodule
